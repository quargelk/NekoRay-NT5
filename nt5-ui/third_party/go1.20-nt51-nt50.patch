diff -ruN a/src/net/lookup_windows_nt50.go b/src/net/lookup_windows_nt50.go
--- a/src/net/lookup_windows_nt50.go	1970-01-01 03:00:00.000000000 +0300
+++ b/src/net/lookup_windows_nt50.go	2026-10-18 03:14:06.930844900 +0300
@@ -0,0 +1,79 @@
+// NekoRay NT5 addition for Windows 2000 (NT 5.0); not part of upstream Go (see nt5-ui/third_party/README.md).
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//BACKPORT(NT_50): name and port lookup for Windows 2000, which has no GetAddrInfoW (it is new
+// in Windows XP SP2): gethostbyname and getservbyname of Winsock, as Go 1.0 used them. They
+// know IPv4 only, which is all that Windows 2000 has, and read the hosts file and DNS as
+// GetAddrInfoW does.
+
+package net
+
+import (
+	"runtime"
+	"syscall"
+	"unsafe"
+)
+
+const _WSANO_DATA = syscall.Errno(11004)
+
+func lookupIPNT50(family int32, name string) ([]IPAddr, error) {
+	if family == syscall.AF_INET6 {
+		return nil, &DNSError{Err: errNoSuchHost.Error(), Name: name, IsNotFound: true}
+	}
+	// The result is in thread-local storage of Winsock: stay on this thread until it is copied.
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	h, e := syscall.GetHostByName(name)
+	if e != nil {
+		if e == _WSANO_DATA {
+			e = _WSAHOST_NOT_FOUND
+		}
+		err := winError("gethostbyname", e)
+		dnsError := &DNSError{Err: err.Error(), Name: name}
+		if err == errNoSuchHost {
+			dnsError.IsNotFound = true
+		}
+		return nil, dnsError
+	}
+	if h.AddrType != syscall.AF_INET || h.Length != IPv4len {
+		return nil, &DNSError{Err: syscall.EWINDOWS.Error(), Name: name}
+	}
+	addrs := make([]IPAddr, 0, 5)
+	list := (*[1 << 10]*[4]byte)(unsafe.Pointer(h.AddrList))
+	for i := 0; i < len(list) && list[i] != nil; i++ {
+		a := list[i]
+		addrs = append(addrs, IPAddr{IP: IPv4(a[0], a[1], a[2], a[3])})
+	}
+	if len(addrs) == 0 {
+		return nil, &DNSError{Err: errNoSuchHost.Error(), Name: name, IsNotFound: true}
+	}
+	return addrs, nil
+}
+
+func lookupPortNT50(network, service string) (int, error) {
+	proto := "tcp"
+	switch network {
+	case "udp", "udp4", "udp6":
+		proto = "udp"
+	}
+	runtime.LockOSThread()
+	s, e := syscall.GetServByName(service, proto)
+	port := 0
+	if e == nil {
+		port = int(syscall.Ntohs(s.Port))
+	}
+	runtime.UnlockOSThread()
+	if e == nil {
+		return port, nil
+	}
+	if port, err := lookupPortMap(network, service); err == nil {
+		return port, nil
+	}
+	err := winError("getservbyname", e)
+	dnsError := &DNSError{Err: err.Error(), Name: network + "/" + service}
+	if err == errNoSuchHost {
+		dnsError.IsNotFound = true
+	}
+	return 0, dnsError
+}
