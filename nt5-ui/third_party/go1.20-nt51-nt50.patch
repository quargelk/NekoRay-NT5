diff -ruN a/src/internal/syscall/windows/nt50_windows.go b/src/internal/syscall/windows/nt50_windows.go
--- a/src/internal/syscall/windows/nt50_windows.go	1970-01-01 03:00:00.000000000 +0300
+++ b/src/internal/syscall/windows/nt50_windows.go	2026-10-18 03:14:07.050862400 +0300
@@ -0,0 +1,121 @@
+// NekoRay NT5 addition for Windows 2000 (NT 5.0); not part of upstream Go (see nt5-ui/third_party/README.md).
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//BACKPORT(NT_50): helpers for Windows 2000 (NT 5.0), which lacks some functions of Windows XP.
+
+package windows
+
+import (
+	"sync"
+	"syscall"
+	"unsafe"
+)
+
+// nt50Simulate is set to "1" only by test builds (-ldflags "-X internal/syscall/windows.nt50Simulate=1"):
+// the Windows XP functions below are then treated as missing, as on Windows 2000.
+var nt50Simulate string
+
+var errNT50Simulated = syscall.Errno(127) // ERROR_PROC_NOT_FOUND
+
+// SimulateNT50 reports whether this is such a test build.
+func SimulateNT50() bool {
+	return nt50Simulate == "1"
+}
+
+// LoadRtlGenRandom reports whether advapi32 has RtlGenRandom (SystemFunction036, Windows XP and newer).
+func LoadRtlGenRandom() error {
+	if SimulateNT50() {
+		return errNT50Simulated
+	}
+	return procSystemFunction036.Find()
+}
+
+// LoadConnectEx reports whether Winsock has ConnectEx (Windows XP and newer).
+func LoadConnectEx() error {
+	if SimulateNT50() {
+		return errNT50Simulated
+	}
+	return syscall.LoadConnectEx()
+}
+
+// LoadGetAddrInfo reports whether ws2_32 has GetAddrInfoW (Windows XP SP2 and newer).
+func LoadGetAddrInfo() error {
+	if SimulateNT50() {
+		return errNT50Simulated
+	}
+	return syscall.LoadGetAddrInfo()
+}
+
+var cryptProv struct {
+	once sync.Once
+	h    syscall.Handle
+	err  error
+}
+
+// CryptGenRandom fills buf from CryptGenRandom of the default RSA provider (a verification
+// context, no key container). This is how crypto/rand worked on every Windows version up to
+// Go 1.10; it is used only when RtlGenRandom is missing.
+func CryptGenRandom(buf []byte) error {
+	cryptProv.once.Do(func() {
+		cryptProv.err = syscall.CryptAcquireContext(&cryptProv.h, nil, nil, syscall.PROV_RSA_FULL, syscall.CRYPT_VERIFYCONTEXT)
+	})
+	if cryptProv.err != nil {
+		return cryptProv.err
+	}
+	if len(buf) == 0 {
+		return nil
+	}
+	return syscall.CryptGenRandom(cryptProv.h, uint32(len(buf)), &buf[0])
+}
+
+// LoadGetAdaptersAddresses reports whether iphlpapi has GetAdaptersAddresses (Windows XP and newer).
+func LoadGetAdaptersAddresses() error {
+	if SimulateNT50() {
+		return errNT50Simulated
+	}
+	return procGetAdaptersAddresses.Find()
+}
+
+const (
+	WSAEWOULDBLOCK syscall.Errno = 10035
+	WSAENOTSOCK    syscall.Errno = 10038
+	FIONBIO                      = 0x8004667e
+	SO_ERROR                     = 0x1007
+)
+
+// FdSet is the fd_set of Winsock (FD_SETSIZE 64).
+type FdSet struct {
+	Count uint32
+	Array [64]syscall.Handle
+}
+
+var (
+	procselect      = modws2_32.NewProc("select")
+	procioctlsocket = modws2_32.NewProc("ioctlsocket")
+)
+
+// Select calls Winsock select; nfds is ignored by Winsock.
+func Select(readfds, writefds, exceptfds *FdSet, timeout *syscall.Timeval) (n int, err error) {
+	r0, _, e1 := syscall.Syscall6(procselect.Addr(), 5, 0, uintptr(unsafe.Pointer(readfds)),
+		uintptr(unsafe.Pointer(writefds)), uintptr(unsafe.Pointer(exceptfds)), uintptr(unsafe.Pointer(timeout)), 0)
+	if int32(r0) == -1 {
+		if e1 != 0 {
+			return -1, error(e1)
+		}
+		return -1, syscall.EINVAL
+	}
+	return int(int32(r0)), nil
+}
+
+// Ioctlsocket calls Winsock ioctlsocket.
+func Ioctlsocket(s syscall.Handle, cmd uint32, arg *uint32) error {
+	r0, _, e1 := syscall.Syscall(procioctlsocket.Addr(), 3, uintptr(s), uintptr(cmd), uintptr(unsafe.Pointer(arg)))
+	if int32(r0) != 0 {
+		if e1 != 0 {
+			return error(e1)
+		}
+		return syscall.EINVAL
+	}
+	return nil
+}
