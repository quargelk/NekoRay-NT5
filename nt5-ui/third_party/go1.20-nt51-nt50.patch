diff -ruN a/src/net/fd_windows_nt50.go b/src/net/fd_windows_nt50.go
--- a/src/net/fd_windows_nt50.go	1970-01-01 03:00:00.000000000 +0300
+++ b/src/net/fd_windows_nt50.go	2026-10-18 03:14:06.805958500 +0300
@@ -0,0 +1,88 @@
+// NekoRay NT5 addition for Windows 2000 (NT 5.0); not part of upstream Go (see nt5-ui/third_party/README.md).
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//BACKPORT(NT_50): TCP connect for Windows 2000, which has no ConnectEx (Windows XP and newer).
+
+package net
+
+import (
+	"context"
+	"internal/syscall/windows"
+	"os"
+	"syscall"
+	"time"
+	"unsafe"
+)
+
+// connectPollInterval bounds how long a cancelled dial can still wait in select.
+const connectPollInterval = 50 * time.Millisecond
+
+// connectNT50 starts a non-blocking connect and waits in select (at most connectPollInterval
+// at a time) until it completes, fails, the context is done or its deadline passes. The socket
+// is put back into blocking mode afterwards; its overlapped I/O through the completion port
+// works as with ConnectEx. While it waits, it occupies one thread, as a blocking connect would.
+func (fd *netFD) connectNT50(ctx context.Context, ra syscall.Sockaddr) error {
+	s := fd.pfd.Sysfd
+	on := uint32(1)
+	if err := windows.Ioctlsocket(s, windows.FIONBIO, &on); err != nil {
+		return os.NewSyscallError("ioctlsocket", err)
+	}
+	err := fd.connectWaitNT50(ctx, s, ra)
+	off := uint32(0)
+	if err2 := windows.Ioctlsocket(s, windows.FIONBIO, &off); err == nil && err2 != nil {
+		err = os.NewSyscallError("ioctlsocket", err2)
+	}
+	return err
+}
+
+func (fd *netFD) connectWaitNT50(ctx context.Context, s syscall.Handle, ra syscall.Sockaddr) error {
+	switch err := connectFunc(s, ra); err {
+	case nil:
+		return nil
+	case windows.WSAEWOULDBLOCK:
+	default:
+		return os.NewSyscallError("connect", err)
+	}
+	for {
+		select {
+		case <-ctx.Done():
+			return mapErr(ctx.Err())
+		default:
+		}
+		wait := connectPollInterval
+		if deadline, ok := ctx.Deadline(); ok {
+			left := time.Until(deadline)
+			if left <= 0 {
+				return mapErr(context.DeadlineExceeded)
+			}
+			if left < wait {
+				wait = left
+			}
+		}
+		var w, e windows.FdSet
+		w.Count, w.Array[0] = 1, s
+		e.Count, e.Array[0] = 1, s
+		tv := syscall.NsecToTimeval(int64(wait))
+		n, err := windows.Select(nil, &w, &e, &tv)
+		if err != nil {
+			return os.NewSyscallError("select", err)
+		}
+		if n == 0 {
+			continue
+		}
+		var soerr int32
+		l := int32(unsafe.Sizeof(soerr))
+		if err := syscall.Getsockopt(s, syscall.SOL_SOCKET, windows.SO_ERROR, (*byte)(unsafe.Pointer(&soerr)), &l); err != nil {
+			return os.NewSyscallError("getsockopt", err)
+		}
+		if soerr != 0 {
+			return os.NewSyscallError("connect", syscall.Errno(soerr))
+		}
+		if e.Count != 0 {
+			// failed, but without a reason in SO_ERROR
+			return os.NewSyscallError("connect", syscall.Errno(syscall.WSAECONNABORTED))
+		}
+		return nil
+	}
+}
