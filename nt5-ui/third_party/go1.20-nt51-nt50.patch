+// handlers (AddVectoredExceptionHandler is new in Windows XP).
+//
+// Every thread that the runtime starts (and the main thread) registers sehtramp as a
+// structured exception handler at the base of its OS stack (sys_windows_386.s,
+// rt0_windows_386.s). Windows calls it for an exception that no inner SEH frame handled,
+// on the stack where the exception happened, as it calls a vectored handler; sehtramp
+// passes it to exceptionhandler through sigtramp, which switches to g0. So a fault in Go code
+// becomes a Go panic as before. Exceptions on threads without that frame (threads that enter
+// Go through a callback) and exceptions that are not Go's reach the top-level filter
+// unhandledtramp: exceptionhandler again, then lastcontinuehandler, which prints the crash
+// report and exits, as the top-level filter does on windows/386 with VEH.
+//
+// With VEH (Windows XP and newer) useSEH stays 0, sehtramp passes every exception on at once,
+// and nothing changes.
+
+package runtime
+
+import (
+	"internal/abi"
+	"runtime/internal/atomic"
+)
+
+// in sys_windows_386.s
+func sehtramp()
+func unhandledtramp()
+
+// useSEH is read by sehtramp: 1 when exceptions are handled through SEH frames.
+var useSEH uint32
+
+// Number of exceptions that reached sehhandler and unhandledhandler; for tests
+// (nt50probe reads them with go:linkname).
+var nt50SEHCalls, nt50UEFCalls uint32
+
+// Called by sigtramp from sehtramp.
+//
+//go:nosplit
+func sehhandler(info *exceptionrecord, r *context, gp *g) int32 {
+	atomic.Xadd(&nt50SEHCalls, 1)
+	return exceptionhandler(info, r, gp)
+}
+
+func initExceptionHandlerNT50() {
+	useSEH = 1
+	stdcall1(_SetUnhandledExceptionFilter, abi.FuncPCABI0(unhandledtramp))
+}
+
+// Called by sigtramp from the top-level exception filter when there is no VEH.
+//
+//go:nosplit
+func unhandledhandler(info *exceptionrecord, r *context, gp *g) int32 {
+	atomic.Xadd(&nt50UEFCalls, 1)
+	if exceptionhandler(info, r, gp) == _EXCEPTION_CONTINUE_EXECUTION {
+		return _EXCEPTION_CONTINUE_EXECUTION
+	}
+	return lastcontinuehandler(info, r, gp)
+}
