  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!--
    Puts the core and the helpers (..\runtime\*, see README.txt there) next to the program, so that F5
    starts a build that can connect. cacert.pem (Mozilla CA bundle, kept in Git) is copied by name, so
    HTTPS subscriptions on Windows XP never depend on its outdated root store.
    Release also assembles the package to copy to the target system: $(OutDir)package\ holds only
    the files the program needs (no .pdb, no .vshost.exe).
  -->
  <Target Name="AfterBuild">
    <ItemGroup>
      <RuntimeFiles Include="$(MSBuildProjectDirectory)\..\runtime\*.*" Exclude="$(MSBuildProjectDirectory)\..\runtime\README.txt;$(MSBuildProjectDirectory)\..\runtime\cacert.pem" />
      <CaBundleFile Include="$(MSBuildProjectDirectory)\..\runtime\cacert.pem" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CaBundleFile)" DestinationFolder="$(OutDir)" Condition="Exists('$(MSBuildProjectDirectory)\..\runtime\cacert.pem')" />
    <Warning Condition="!Exists('$(OutDir)xray.exe')" Text="xray.exe is not in $(OutDir): the program will start but cannot connect. Put xray.exe into nt5-ui\runtime (see README.txt there)." />
    <Warning Condition="!Exists('$(OutDir)nt5helper.exe')" Text="nt5helper.exe is not in $(OutDir): HTTPS subscriptions then need curl.exe. Build it with nt5-ui\helper\build.cmd (see runtime\README.txt)." />
    <Warning Condition="!Exists('$(OutDir)cacert.pem')" Text="cacert.pem is not in $(OutDir): HTTPS subscriptions on Windows XP will fail with an unknown certificate authority. Restore nt5-ui\runtime\cacert.pem from Git." />
    <ItemGroup Condition="'$(Configuration)' == 'Release'">
      <PackageFiles Include="$(OutDir)$(TargetFileName);@(RuntimeFiles->'$(OutDir)%(Filename)%(Extension)');@(CaBundleFile->'$(OutDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Release'">
      <PackageDocs Include="$(MSBuildProjectDirectory)\..\dist\README.txt" />
      <PackageLicenses Include="$(MSBuildProjectDirectory)\..\licenses\**\*.txt" />
    </ItemGroup>
    <RemoveDir Condition="'$(Configuration)' == 'Release'" Directories="$(OutDir)package" />
    <Copy Condition="'$(Configuration)' == 'Release'" SourceFiles="@(PackageFiles);@(PackageDocs)" DestinationFolder="$(OutDir)package" />
    <Copy Condition="'$(Configuration)' == 'Release'" SourceFiles="@(PackageLicenses)" DestinationFiles="@(PackageLicenses->'$(OutDir)package\licenses\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>